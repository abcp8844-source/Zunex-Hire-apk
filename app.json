{
  "expo": {
    "name": "Zunexhire",
    "slug": "zunexhire",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-512.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/logo-192.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zunexhire.app"
    },
    "android": {
      "package": "com.zunexhire.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo-192.png",
        "backgroundColor": "#1877F2"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.ico"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Zunexhire to access your photos to share posts and update profile."
        }
      ]
    ]
  }
}
